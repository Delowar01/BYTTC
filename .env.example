# Supabase project (Project Settings → API). The anon/publishable key is public.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY — never expose to the browser or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=
# Public base URL of the site (used in QR codes, emails and SEO).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Used only by `npm run seed:users` to bootstrap the first Super Admin.
SEED_SUPER_ADMIN_EMAIL=superadmin@example.org
# Quote values containing "#". Min 10 chars with upper, lower and digit.
SEED_SUPER_ADMIN_PASSWORD=
